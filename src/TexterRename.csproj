<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TexterRename</RootNamespace>
    <AssemblyName>TexterRename</AssemblyName>

    <!-- Windows App SDK / WinUI 3 -->
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <UnoIcon Include="app_icon.png" />
    <Content Include="app_icon.png" CopyToOutputDirectory="PreserveNewest" />
    <UnoFeatures Include="SkiaRenderer" />
  </ItemGroup>

  <!-- Compiles whitelist.txt directly into the executable for Default mode -->
  <ItemGroup>
    <EmbeddedResource Include="whitelist.txt" />
  </ItemGroup>
</Project>
