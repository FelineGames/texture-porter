<Page
    x:Class="TexterRename.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TexterRename.Controls"
    Background="#202124"
    RequestedTheme="Dark">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:CustomTitleBar x:Name="TopTitleBar" Grid.Row="0" />

        <Grid Grid.Row="1" Padding="18,16,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:FolderInputRow x:Name="SourceRow"
                                     Grid.Row="0"
                                     Label="Source"
                                     IconData="M 1.5,1.5 L 5.5,1.5 L 7.2,3.2 L 13.5,3.2 C 14.3,3.2 15,3.9 15,4.7 L 15,11.5 C 15,12.3 14.3,13 13.5,13 L 1.5,13 C 0.7,13 0,12.3 0,11.5 L 0,3 C 0,2.2 0.7,1.5 1.5,1.5 Z"
                                     BrowseClicked="OnBrowseSourceClick" />

            <controls:FolderInputRow x:Name="OutputRow"
                                     Grid.Row="2"
                                     Label="Output"
                                     IconData="M 1,8 L 1,12 C 1,12.8 1.7,13.5 2.5,13.5 L 12.5,13.5 C 13.3,13.5 14,12.8 14,12 L 14,8 M 7.5,1 L 7.5,9.5 M 4.5,6.8 L 7.5,9.8 L 10.5,6.8"
                                     BrowseClicked="OnBrowseOutputClick" />

            <controls:FolderInputRow x:Name="MappingRow"
                                     Grid.Row="4"
                                     Label="Mapping"
                                     IsBrowseEnabled="False"
                                     IconData="M 1,3 L 5.3,1.2 L 9.7,3 L 14,1.2 L 14,11.5 L 9.7,13.3 L 5.3,11.5 L 1,13.3 Z M 5.3,1.2 L 5.3,11.5 M 9.7,3 L 9.7,13.3"
                                     BrowseClicked="OnBrowseMappingClick" />

            <Grid Grid.Row="6" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="#D4D8DF" />
                    <TextBlock Text="Mode" FontSize="13" Foreground="#E4E7EC" VerticalAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="1"
                        BorderBrush="{StaticResource ModeBorderGradient}"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        Background="#253246">
                    <ComboBox x:Name="ModeComboBox"
                              Width="112"
                              Height="28"
                              SelectedIndex="0"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="#F0F4F8"
                              FontSize="12.5"
                              Padding="10,0,8,0"
                              SelectionChanged="OnModeSelectionChanged">
                        <ComboBoxItem Content="Default" />
                        <ComboBoxItem Content="Custom" />
                    </ComboBox>
                </Border>
            </Grid>

            <Grid Grid.Row="8">
                <Button Content="Clear All"
                        HorizontalAlignment="Left"
                        Style="{StaticResource ClearButtonStyle}"
                        Click="OnClearAllClick" />

                <Button Content="Start Process"
                        HorizontalAlignment="Right"
                        Style="{StaticResource StartButtonStyle}"
                        Click="OnStartProcessClick" />
            </Grid>
        </Grid>
    </Grid>
</Page>
