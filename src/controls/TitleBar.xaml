<UserControl
    x:Class="TexterRename.Controls.CustomTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="DragRegion" Height="34" Background="#17191E" Padding="14,0">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <Image Source="ms-appx:///app_icon.png"
                   Width="16"
                   Height="16"
                   VerticalAlignment="Center" />
            <TextBlock Text="TexterRename"
                       FontSize="12"
                       Foreground="#E4E7EC"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
